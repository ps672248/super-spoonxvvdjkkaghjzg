# Port the service listens on
PORT=8080

# Firebase Admin service-account credentials.
# Either point to a JSON file path...
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# ...or inline the JSON (useful for hosted envs like Render/Railway/Fly).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Comma-separated origins allowed to call write/report endpoints.
ALLOWED_ORIGINS=https://aspirant-arcade-fwa8.vercel.app

# Shared secret. When set, write/report calls must send a matching `x-bank-secret`
# header. The app must ship the SAME value as EXPO_PUBLIC_QUESTION_BANK_SECRET.
# Leave blank to disable the gate (dev only).
SUBMIT_SECRET=
