# ── Gemini API Keys ───────────────────────────────────────────────────────────
# Comma-separated list of keys for round-robin rotation (free tier: 500 RPD/key)
# 9 keys → 4500 RPD total → SEED_TOPICS_PER_RUN=12 safe; 6 keys → keep ≤ 8
GEMINI_API_KEYS=key1,key2,key3

# Single key fallback (used if GEMINI_API_KEYS is not set)
# GEMINI_API_KEY=your_gemini_key_here

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Option A — inline JSON (CI / cloud deploy, no file needed)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Option B — path to service-account.json file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── Seeder Tuning ─────────────────────────────────────────────────────────────
# Number of topics to seed per CI run
SEED_TOPICS_PER_RUN=12

# Questions generated per difficulty level per topic (1–10 levels)
SEED_PER_DIFFICULTY=10

# Gemini model to use for generation
SEED_MODEL=gemini-3.1-flash-lite
