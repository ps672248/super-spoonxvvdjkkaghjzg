# Expo public env vars (EXPO_PUBLIC_* are embedded in the client bundle).
# Copy to .env and fill in. Rebuild the app after changing these.

# Question-bank backend origin (the deployed backend/ service).
EXPO_PUBLIC_QUESTION_BANK_URL=https://your-backend-host.example.com

# Shared secret for write/report calls. Must equal the backend's SUBMIT_SECRET.
# NOTE: this value ships inside the app bundle, so it only deters casual abuse —
# it is not a strong secret. Use Firebase App Check for real protection.
EXPO_PUBLIC_QUESTION_BANK_SECRET=

# Optional: override the website Gemini proxy used in embed (iframe) mode.
# EXPO_PUBLIC_GEMINI_PROXY_URL=https://aspirant-arcade.vercel.app/api/gemini
